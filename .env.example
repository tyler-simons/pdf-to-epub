# No API credits or hosting are provisioned by these settings.
LEAF_PUBLIC=false
LEAF_DATA_DIR=/data
# Public mode is open to anyone, with server-validated bot protection.
# Configure these on the host before setting LEAF_PUBLIC=true.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
LEAF_PUBLIC_HOSTNAME=
# Generate once with: python -c 'import secrets; print(secrets.token_hex(32))'
# Keep stable across deploys; used to hash client addresses for rate limits.
LEAF_ACCESS_SECRET=
LEAF_PER_CLIENT_DAILY_JOBS=3
LEAF_DAILY_JOBS=20
LEAF_AI_ENABLED=false
OPENAI_API_KEY=
# App allowance only, not purchased credits; $9 leaves a buffer below $10 funded.
LEAF_AI_BUDGET_MICROUSD=9000000
LEAF_AI_PER_JOB_MICROUSD=100000
