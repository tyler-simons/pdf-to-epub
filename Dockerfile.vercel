FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    OMP_THREAD_LIMIT=1 \
    PORT=80

RUN apt-get update \
    && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --create-home leaf

WORKDIR /app
COPY requirements.txt requirements-vercel.txt ./
RUN pip install --no-cache-dir -r requirements-vercel.txt
COPY app ./app
RUN chown -R leaf:leaf /app
USER leaf
EXPOSE 80
CMD ["sh", "-c", "uvicorn app.vercel_worker:app --host 0.0.0.0 --port ${PORT:-80} --workers 1 --no-access-log --limit-concurrency 4 --timeout-keep-alive 5"]
